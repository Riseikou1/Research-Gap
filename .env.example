# Optional OpenAI features. Leave the key empty for deterministic planning and lexical ranking.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EXTRACTION_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenAlex works without a key; a key enables its semantic-search route.
OPENALEX_API_KEY=
OPENALEX_MAILTO=
OPENALEX_CANDIDATE_LIMIT=20
OPENALEX_TIMEOUT_SECONDS=20
OPENALEX_MAX_RETRIES=2

# Bounded pipeline work.
RESEARCH_GAP_MAX_CANDIDATES=100
RESEARCH_GAP_RETRIEVAL_WORKERS=4
RESEARCH_GAP_EVIDENCE_LIMIT=10
RESEARCH_GAP_EXTRACTION_WORKERS=4
RESEARCH_GAP_EXTRACTION_BATCH_SIZE=3
RESEARCH_GAP_EMBEDDING_BATCH_SIZE=100

# Ranking and fallback policy.
RESEARCH_GAP_LEXICAL_WEIGHT=0.4
RESEARCH_GAP_SEMANTIC_WEIGHT=0.6
RESEARCH_GAP_CONSTRAINT_WEIGHT=0.15
RESEARCH_GAP_SEMANTIC_FALLBACK=lexical

# Local caches. This directory is ignored by Git.
RESEARCH_GAP_CACHE_DIR=data/cache
RESEARCH_GAP_RETRIEVAL_CACHE_TTL_SECONDS=21600
