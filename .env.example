OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EXTRACTION_MODEL=gpt-5.6-luna
OPENALEX_API_KEY=
OPENALEX_MAILTO=
OPENALEX_CANDIDATE_LIMIT=20
OPENALEX_TIMEOUT_SECONDS=20
OPENALEX_MAX_RETRIES=2
RESEARCH_GAP_MAX_CANDIDATES=100
RESEARCH_GAP_RETRIEVAL_WORKERS=4
RESEARCH_GAP_LEXICAL_WEIGHT=0.4
RESEARCH_GAP_SEMANTIC_WEIGHT=0.6
RESEARCH_GAP_CONSTRAINT_WEIGHT=0.15
RESEARCH_GAP_SEMANTIC_FALLBACK=lexical
RESEARCH_GAP_EVIDENCE_LIMIT=10
RESEARCH_GAP_EXTRACTION_WORKERS=4
RESEARCH_GAP_EXTRACTION_BATCH_SIZE=3
RESEARCH_GAP_CACHE_DIR=data/cache
RESEARCH_GAP_RETRIEVAL_CACHE_TTL_SECONDS=21600
RESEARCH_GAP_DATABASE_PATH=data/research_gap.sqlite3
RESEARCH_GAP_MAX_ANALYSIS_WORKERS=2
RESEARCH_GAP_FULL_TEXT_TIMEOUT_SECONDS=12
RESEARCH_GAP_FULL_TEXT_MAX_BYTES=8000000
RESEARCH_GAP_FULL_TEXT_MAX_DOCUMENT_CHARS=120000
RESEARCH_GAP_FULL_TEXT_MAX_SECTION_CHARS=20000
RESEARCH_GAP_FULL_TEXT_MAX_CHUNK_CHARS=8000
RESEARCH_GAP_FULL_TEXT_MAX_CONTEXT_CHARS=30000
RESEARCH_GAP_FULL_TEXT_MAX_REDIRECTS=3
RESEARCH_GAP_FULL_TEXT_NEGATIVE_CACHE_TTL_SECONDS=3600

# Milestone 9 web/auth/security. NEXT_PUBLIC values also go in web/.env.local.
RESEARCH_GAP_APP_URL=http://localhost:3000
RESEARCH_GAP_ALLOWED_ORIGINS=http://localhost:3000
RESEARCH_GAP_GUEST_COOKIE_SECRET=replace-with-at-least-32-random-bytes
RESEARCH_GAP_SECURE_COOKIES=false
# Set true only for the old single-owner loopback API; never use on a public deployment.
RESEARCH_GAP_TRUSTED_LOCAL_MODE=false
RESEARCH_GAP_GUEST_RETENTION_HOURS=72
RESEARCH_GAP_GUEST_QUICK_LIMIT=1
RESEARCH_GAP_USER_QUICK_DAILY_LIMIT=10
RESEARCH_GAP_MAX_ACTIVE_PER_PRINCIPAL=2
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=

# Stripe test mode only. Never place bank details here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
RESEARCH_GAP_PAID_CYCLE_CREDITS=5
RESEARCH_GAP_PAID_PRICE_DISPLAY_USD=1.00
RESEARCH_GAP_ACKNOWLEDGE_LIVE_PRICING=false
